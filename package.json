{
  "name": "serveit",
  "version": "0.1.0",
  "description": "Serve a single file over HTTP on all interfaces and print the URLs to reach it",
  "type": "module",
  "bin": {
    "serveit": "src/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
